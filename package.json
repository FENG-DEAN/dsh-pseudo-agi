{
  "name": "@pseudo-agi/bundle",
  "version": "0.4.0",
  "description": "Whale-girl AGI for the DeepSeek Harness: layered memory, controlled hands, a consciousness scaffold, read-only governance, and a management panel",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./layers/*": "./layers/*.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "layers",
    "vendor",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "author": "FENG-DEAN <firebanyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FENG-DEAN/dsh-pseudo-agi.git"
  },
  "homepage": "https://github.com/FENG-DEAN/dsh-pseudo-agi#readme",
  "bugs": {
    "url": "https://github.com/FENG-DEAN/dsh-pseudo-agi/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "agi",
    "memory",
    "panel"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "load-test": "node scripts/load-test.mjs",
    "panel-test": "node scripts/panel-test.mjs",
    "store-test": "node scripts/store-test.mjs",
    "bundle-test": "node scripts/bundle-test.mjs",
    "release-check": "node scripts/release-check.mjs",
    "pack-bundle": "node scripts/pack-bundle.mjs",
    "vendor": "node scripts/vendor-layers.mjs",
    "clean:build": "node scripts/clean.mjs",
    "verify": "pnpm build && pnpm vendor && pnpm smoke && pnpm store-test && pnpm load-test && pnpm panel-test && pnpm bundle-test && pnpm release-check",
    "prepublishOnly": "node scripts/assert-vendored.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "js-yaml": "^5.5.0",
    "typescript": "^5.7.2"
  }
}
