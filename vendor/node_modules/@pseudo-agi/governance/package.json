{
  "name": "@pseudo-agi/governance",
  "version": "0.4.0",
  "description": "Read-only evaluation and audit layer for the pseudo-AGI: decision/action/outcome triples, metrics, and replayable JSONL",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src"
  ],
  "author": "FENG-DEAN <firebanyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FENG-DEAN/dsh-pseudo-agi.git"
  },
  "homepage": "https://github.com/FENG-DEAN/dsh-pseudo-agi#readme",
  "bugs": {
    "url": "https://github.com/FENG-DEAN/dsh-pseudo-agi/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "observability",
    "audit",
    "jsonl"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@pseudo-agi/store": "workspace:^0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@pseudo-agi/memory": "^0.4.0",
    "@pseudo-agi/scaffold": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@pseudo-agi/memory": {
      "optional": true
    },
    "@pseudo-agi/scaffold": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@pseudo-agi/memory": "workspace:*",
    "@pseudo-agi/scaffold": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
