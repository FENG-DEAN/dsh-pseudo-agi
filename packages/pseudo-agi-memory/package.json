{
  "name": "@pseudo-agi/memory",
  "version": "0.1.0",
  "description": "Layered, Markdown-first memory for the DeepSeek Harness: working / episodic / semantic / procedural",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./events": {
      "types": "./lib/events.d.ts",
      "default": "./lib/events.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@pseudo-agi/store": "workspace:^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
