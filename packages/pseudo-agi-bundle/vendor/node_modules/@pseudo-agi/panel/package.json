{
  "name": "@pseudo-agi/panel",
  "version": "0.1.0",
  "description": "Whale-girl AGI management panel for the DeepSeek Harness: a left-sidebar entry plus a read-only panel over the pseudo-AGI state (layers, memories, event journal, working bench)",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js"
  ],
  "author": "FENG-DEAN <firebanyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FENG-DEAN/dsh-pseudo-agi.git"
  },
  "homepage": "https://github.com/FENG-DEAN/dsh-pseudo-agi#readme",
  "bugs": {
    "url": "https://github.com/FENG-DEAN/dsh-pseudo-agi/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "panel",
    "ui",
    "read-only"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@pseudo-agi/store": "workspace:^0.1.0"
  }
}
